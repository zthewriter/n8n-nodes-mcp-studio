{
  "name": "n8n-nodes-mcp-studio",
  "version": "0.2.1",
  "description": "Give AI agents persistent context in n8n. Turn docs, code repositories, PDFs, specs, and other MCP servers into a live Model Context Protocol endpoint your workflows and agents read before they act, without writing code.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "mcp",
    "model-context-protocol",
    "mcp-studio",
    "ai-agent",
    "ai-context",
    "context-engineering",
    "documentation",
    "rag"
  ],
  "license": "MIT",
  "homepage": "https://appatools.com/mcp-studio",
  "author": {
    "name": "Appa Tools",
    "email": "zair@appatools.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zthewriter/n8n-nodes-mcp-studio.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "scripts": {
    "build": "npx rimraf dist && tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "lint:n8n": "n8n-node lint",
    "prepublishOnly": "npm run build && eslint -c .eslintrc.prepublish.js nodes credentials package.json",
    "release": "npm publish --provenance --access public"
  },
  "files": [
    "dist",
    "workflows"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/McpStudioApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/McpStudio/McpStudio.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.45.4",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "gulp": "^5.0.0",
    "n8n-workflow": "^1.110.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
